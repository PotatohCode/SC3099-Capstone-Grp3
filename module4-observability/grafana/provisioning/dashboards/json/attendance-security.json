        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(checkin_attempts_total[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true

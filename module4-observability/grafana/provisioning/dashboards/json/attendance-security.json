    {
      "id": 15,
      "type": "bargauge",
      "title": "Risk score distribution (selected time range)",
      "description": "Risk bands as used by the backend (SECURITY-REQUIREMENTS).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(risk_score_bucket{le=\"0.3\"}[$__range]))",
          "legendFormat": "Low  (< 0.3) · auto-approved",
          "refId": "A",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(risk_score_bucket{le=\"0.5\"}[$__range])) - sum(increase(risk_score_bucket{le=\"0.3\"}[$__range]))",
          "legendFormat": "Medium (0.3–0.5)",
          "refId": "B",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(risk_score_bucket{le=\"0.7\"}[$__range])) - sum(increase(risk_score_bucket{le=\"0.5\"}[$__range]))",
          "legendFormat": "High (0.5–0.7) · review",
          "refId": "C",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(risk_score_bucket{le=\"+Inf\"}[$__range])) - sum(increase(risk_score_bucket{le=\"0.7\"}[$__range]))",
          "legendFormat": "Critical (≥ 0.7) · rejected",
          "refId": "D",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
